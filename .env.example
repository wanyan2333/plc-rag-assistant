# Copy to .env and fill in. Never commit .env.

# --- LLM -------------------------------------------------------------------
# "anthropic" (Claude, primary), "gemini" (Google, alternative) or "fake" (offline, no key).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Effort for answer generation: low | medium | high
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback ("default" enables it, empty disables it)
ANTHROPIC_FALLBACKS=default

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# LLM-as-judge model for eval/run.py (empty = same model as the answers)
JUDGE_MODEL=
# Optional price override (USD / 1M tokens) for cost reporting of models not in the built-in table
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# --- Embeddings ------------------------------------------------------------
# "sentence-transformers" (local, free) or "hash" (offline, deterministic, test only)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Paths -----------------------------------------------------------------
RAW_DIR=data/raw
INDEX_DIR=data/index

# --- Chunking (approximate tokens) -----------------------------------------
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=80

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_MODE=hybrid
TOP_K=6

# --- UI --------------------------------------------------------------------
API_URL=http://127.0.0.1:8000
